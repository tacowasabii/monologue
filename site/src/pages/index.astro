---
import { Image } from 'astro:assets';
import list from '../assets/01-list.png';
import paragraphs from '../assets/02-paragraphs.png';
import dialogue from '../assets/03-dialogue.png';
import immersive from '../assets/04-immersive.png';
import practice from '../assets/05-practice.png';

const shots = [
  { src: list, alt: '즐겨찾기한 대본이 위에 모인 대본 목록 화면', caption: '캡처해 둔 대본을 한곳에' },
  { src: paragraphs, alt: '사진에서 인식한 문단을 골라 담는 화면', caption: '사진에서 필요한 문단만 골라' },
  { src: dialogue, alt: '내 역할 대사를 진하게 보여 주는 대화 대본 화면', caption: '내 역할 대사는 또렷하게' },
  { src: immersive, alt: '메뉴 없이 대본만 보여 주는 몰입 읽기 화면', caption: '메뉴 없이 대본에만 몰입' },
  { src: practice, alt: '대본 아래 녹음과 영상이 모인 연습 기록 화면', caption: '녹음·영상으로 연습 기록' },
];

const features = [
  ['사진으로 바로 저장', '사진첩에서 여러 장을 고르거나 카메라로 찍으면 순서대로 이어붙여 대본 하나로 만들어요. 휴대폰 상태바는 알아서 빼요.'],
  ['모음으로 정리', "'1차 오디션'처럼 모음을 만들어 대본을 넣고 순서를 정해요. 즐겨찾기한 대본은 맨 위에 모이고, 작품명·메모·본문·노트로 검색해요."],
  ['대본에 몰입', '대화 대본은 내 역할의 대사를 또렷하게 보여 주고, 노트에는 상황과 떠오르는 생각을 자유롭게 적어요. 몰입 읽기로 대본만 크게 읽어요.'],
  ['연습 기록', '대본을 보면서 녹음하거나 영상을 찍고, 기기에 있는 음성·영상 파일도 대본에 모아 둬요.'],
  ['링크로 보내기', '링크 하나로 대본을 보내면 받은 사람이 눌러서 바로 추가해요. 앱이 없어도 웹에서 읽을 수 있고, 링크는 7일 뒤 사라져요.'],
  ['내 기기에 저장', '로그인이 없고 글자 인식도 기기 안에서 해요. 링크로 공유한 대본만 7일 동안 서버에 올라가요. 기기를 바꿀 땐 백업 파일로 옮겨요.'],
];
const favicon = `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📝</text></svg>`;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="캡처해 둔 독백 대본을 사진으로 올리면 글자를 인식해 한곳에 모아 주는 연기 연습 노트" />
    <title>모노로그</title>
    <link rel="icon" href={favicon} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <main>
      <p class="eyebrow">iPhone · iPad · Android 앱</p>
      <h1>모노로그</h1>
      <p class="lead">캡처해 둔 독백 대본을 사진으로 올리면 글자를 인식해 한곳에 모아 주는 연기 연습 노트예요.</p>
      <p class="badge">App Store · Google Play 출시 준비 중</p>

      <div class="test-download">
        <a class="download" href="/downloads/monologue-android-test.apk" download>Android 테스트 버전 받기 · APK 38MB</a>
        <p class="note">출시 전 테스트용이에요. 설치할 때 '출처를 알 수 없는 앱' 허용이 필요해요. 나중에 Google Play 버전을 설치하려면 이 앱을 먼저 지워야 하고, 지우면 기기에 저장한 대본도 함께 사라져요.</p>
      </div>

      <div class="shots">
        {shots.map((s) => (
          <figure>
            <Image src={s.src} alt={s.alt} widths={[240, 480]} sizes="220px" format="webp" quality={80} />
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))}
      </div>

      <section class="features">
        {features.map(([title, body]) => (
          <div>
            <h2>{title}</h2>
            <p>{body}</p>
          </div>
        ))}
      </section>

      <footer>
        <a href="/privacy">개인정보처리방침</a>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f5f2;
    --fg: #1b1b1c;
    --muted: #6d6c69;
    --line: #e6e4df;
    --accent: #7a4b5c;
    --accent-soft: #f1e6ea;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111213;
      --fg: #ececeb;
      --muted: #9b9a97;
      --line: #2a2b2e;
      --accent: #d9a7b8;
      --accent-soft: #2c2226;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 20px 80px;
  }
  .eyebrow {
    margin: 28px 0 0;
    color: var(--accent);
    font-weight: 600;
  }
  h1 {
    margin: 2px 0 0;
    font-size: clamp(34px, 6vw, 46px);
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 8px 0 0;
    font-size: 17px;
    color: var(--muted);
    word-break: keep-all;
  }
  .badge {
    display: inline-block;
    margin: 18px 0 0;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
  }
  .test-download {
    margin-top: 20px;
  }
  .download {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .note {
    margin: 8px 0 0;
    max-width: 560px;
    font-size: 13px;
    color: var(--muted);
    word-break: keep-all;
  }
  /* 세로 캡처 5장: 가로로 넘겨 본다 */
  .shots {
    display: flex;
    gap: 16px;
    margin: 36px -20px 0;
    padding: 4px 20px 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  figure {
    flex: 0 0 220px;
    margin: 0;
    scroll-snap-align: start;
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    border: 1px solid var(--line);
  }
  figcaption {
    margin-top: 8px;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 8px 32px;
    margin-top: 28px;
  }
  h2 {
    margin: 16px 0 2px;
    font-size: 17px;
  }
  .features p {
    margin: 0;
    color: var(--muted);
    word-break: keep-all;
  }
  footer {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  footer a {
    color: var(--muted);
  }
</style>
