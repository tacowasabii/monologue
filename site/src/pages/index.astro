---
import { Image } from 'astro:assets';
import list from '../assets/01-list.png';
import paragraphs from '../assets/02-paragraphs.png';
import dialogue from '../assets/03-dialogue.png';
import immersive from '../assets/04-immersive.png';
import practice from '../assets/05-practice.png';
import { OG_IMAGE, SITE_ORIGIN } from '../lib/share/http';

const APP_STORE = 'https://apps.apple.com/kr/app/id6812239274';

const extras = [
  ['모음으로 정리', "'1차 오디션'처럼 모음을 만들어 대본을 넣고 순서를 정해요."],
  ['한 구절로 검색', '작품명·한 줄 설명·본문·연기 노트까지 찾아요.'],
  ['내보내기', 'PDF·Word·텍스트로 내보내거나 본문을 그대로 복사해요.'],
  ['iPad에서 나란히', '넓은 화면에서는 목록 옆에 대본이 열려요.'],
  ['백업과 복원', '기기를 바꿀 땐 백업 파일 하나로 옮겨요.'],
  ['내 기기에 저장', '로그인이 없고 글자 인식도 기기 안에서 해요.'],
];

const favicon = `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📝</text></svg>`;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="캡처해 둔 독백 대본을 사진으로 올리면 글자를 인식해 한곳에 모아 주는 연기 연습 노트" />
    <title>모노로그</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE_ORIGIN}/`} />
    <meta property="og:site_name" content="모노로그" />
    <meta property="og:title" content="모노로그" />
    <meta property="og:description" content="사진으로 모으는 독백 대본 노트" />
    <meta property="og:image" content={OG_IMAGE.url} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={favicon} />
    <script is:inline>
      // 등장 효과는 자바스크립트가 살아 있고 모션을 줄이지 않을 때만 건다.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body>
    <header class="bar">
      <a class="wordmark" href="/">모노로그</a>
      <a class="bar-cta" href={APP_STORE}>App Store에서 받기</a>
    </header>

    <main>
      <section class="hero">
        <div class="blob-clip" aria-hidden="true"><div class="blobs"></div></div>
        <p class="pill">iPhone · iPad · Android</p>
        <h1>캡처해 둔 독백 대본,<br />한곳에 모아 둬요</h1>
        <p class="sub">
          사진첩에 흩어진 대본을 올리면 글자를 인식해 텍스트로 저장해요.
          오디션 전날, 어느 사진에 있었는지 찾아 헤매지 않아요.
        </p>

        <div class="cta">
          <a class="app-store" href={APP_STORE}>
            <img src="/badges/app-store-ko.svg" alt="App Store에서 다운로드하기" width="156" height="48" />
          </a>
          <a class="ghost" href="/downloads/monologue-android-test.apk" download>
            Android 테스트 APK
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="micro">로그인 없음 · 대본은 기기에 저장 · iOS 16 이상 · Google Play 출시 준비 중</p>

        <div class="hero-shots">
          <Image class="shot back" src={dialogue} alt="내 역할 대사를 진하게 보여 주는 대화 대본 화면" widths={[280, 560]} sizes="260px" format="webp" quality={85} />
          <Image class="shot front" src={list} alt="즐겨찾기한 대본이 위에 모인 대본 목록 화면" widths={[320, 640]} sizes="300px" format="webp" quality={85} />
          <Image class="shot back" src={practice} alt="대본 아래 녹음과 영상이 모인 연습 기록 화면" widths={[280, 560]} sizes="260px" format="webp" quality={85} />
        </div>
      </section>

      <section class="bento">
        <article class="card wide blush reveal">
          <div class="card-text">
            <h2>사진을 올리면 대본이 돼요</h2>
            <p>
              사진첩에서 여러 장을 한 번에 고르거나 카메라로 찍으면 순서대로 이어붙여 대본 하나로 만들어요.
              필요한 문단만 골라 담고, 인식한 글은 바로 고칠 수 있어요.
            </p>
            <ul class="chips">
              <li>기기 안에서 인식</li>
              <li>문단 골라 담기</li>
              <li>원본 사진 보관</li>
            </ul>
          </div>
          <div class="card-shot peek">
            <Image src={paragraphs} alt="사진에서 인식한 문단을 골라 담는 화면" widths={[280, 560]} sizes="260px" format="webp" quality={85} />
          </div>
        </article>

        <article class="card sand reveal">
          <h2>내 역할 대사만<br />또렷하게</h2>
          <p>대화 장면은 인물별로 나눠 보여주고, 고른 역할의 대사만 진하게 보여요.</p>
          <div class="card-shot peek center">
            <Image src={dialogue} alt="내 역할 대사를 진하게 보여 주는 대화 대본 화면" widths={[260, 520]} sizes="240px" format="webp" quality={85} />
          </div>
        </article>

        <article class="card mist reveal">
          <h2>메뉴 없이<br />대본에만 몰입</h2>
          <p>화면을 가득 채워 대본만 읽어요. 연기 노트에는 상황과 떠오르는 생각을 자유롭게 적어 둬요.</p>
          <div class="card-shot peek center">
            <Image src={immersive} alt="메뉴 없이 대본만 보여 주는 몰입 읽기 화면" widths={[260, 520]} sizes="240px" format="webp" quality={85} />
          </div>
        </article>

        <article class="card wide reveal">
          <div class="card-text">
            <h2>연습은 남겨 두고 다시 들어요</h2>
            <p>
              대본을 보면서 녹음하거나 영상을 찍어 대본 아래에 모아 둬요.
              기기에 있는 음성·영상 파일도 그대로 가져올 수 있어요.
            </p>
            <ul class="chips">
              <li>대본 보며 녹음</li>
              <li>연습 영상</li>
              <li>파일 불러오기</li>
            </ul>
          </div>
          <div class="card-shot peek">
            <Image src={practice} alt="대본 아래 녹음과 영상이 모인 연습 기록 화면" widths={[280, 560]} sizes="260px" format="webp" quality={85} />
          </div>
        </article>

        <article class="card full accent reveal">
          <h2>링크 하나로 대본을 보내요</h2>
          <p>받은 사람은 링크를 눌러 바로 내 대본에 추가해요. 앱이 없어도 웹에서 읽을 수 있고, 링크는 7일 뒤 스스로 사라져요.</p>
          <p class="link-chip"><span>monologue.ink/s/</span>a7Kq2x<em>7일 뒤 만료</em></p>
        </article>
      </section>

      <section class="extras reveal">
        <h2 class="extras-title">그 밖에</h2>
        <div class="extras-grid">
          {extras.map(([title, body]) => (
            <div class="extra">
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="closing reveal">
        <h2>오늘 찍어 둔 대본부터 넣어 보세요</h2>
        <a class="app-store" href={APP_STORE}>
          <img src="/badges/app-store-ko.svg" alt="App Store에서 다운로드하기" width="156" height="48" />
        </a>
        <p class="micro">iPhone · iPad · iOS 16 이상</p>
      </section>
    </main>

    <footer>
      <p class="wordmark">모노로그</p>
      <nav>
        <a href="/privacy">개인정보처리방침</a>
        <a href={APP_STORE}>App Store</a>
      </nav>
      <p class="copy">© 2026 이주현</p>
    </footer>

    <script is:inline>
      // 스크롤에 맞춰 카드를 띄운다. 모션을 줄이는 설정이면 그대로 보여 준다.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf7f3;
    --card: #ffffff;
    --blush: #fbecef;
    --sand: #f4eee4;
    --mist: #ebeff0;
    --fg: #1b1917;
    --muted: #6f6a65;
    --line: #ece5db;
    --accent: #8a4f62;
    --shadow: 0 26px 50px -34px rgba(70, 45, 52, 0.45);
    --radius: 34px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121213;
      --card: #1a1a1c;
      --blush: #241a1e;
      --sand: #211e1a;
      --mist: #1a1e1f;
      --fg: #efedea;
      --muted: #a09a94;
      --line: #2b2b2e;
      --accent: #b9697f;
      --shadow: 0 26px 50px -34px rgba(0, 0, 0, 0.8);
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    font-size: 17px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }
  img {
    max-width: 100%;
  }
  a {
    color: inherit;
  }
  h1,
  h2,
  h3 {
    letter-spacing: -0.035em;
    word-break: keep-all;
    text-wrap: balance;
  }

  /* ───── 상단 바 ───── */
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1160px;
    margin: 0 auto;
    padding: 18px 24px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
  }
  .wordmark {
    margin: 0;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  .bar-cta {
    padding: 9px 18px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .bar-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }

  main {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px 40px;
  }

  /* ───── 히어로 ───── */
  .hero {
    position: relative;
    padding: 72px 0 0;
    text-align: center;
  }
  /* 배경 얼룩이 화면 밖으로 새어 가로 스크롤을 만들지 않게 잘라 둔다 */
  .blob-clip {
    position: absolute;
    inset: 0 0 auto;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
  }
  .blobs {
    position: absolute;
    inset: -120px -10% auto;
    height: 620px;
    background:
      radial-gradient(38% 42% at 22% 30%, var(--blush) 0%, transparent 70%),
      radial-gradient(34% 40% at 78% 24%, var(--sand) 0%, transparent 70%),
      radial-gradient(30% 36% at 52% 62%, var(--mist) 0%, transparent 72%);
    filter: blur(6px);
  }
  .pill {
    display: inline-block;
    margin: 0;
    padding: 6px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
  }
  h1 {
    margin: 22px auto 0;
    max-width: 16em;
    font-size: clamp(38px, 5.6vw, 66px);
    font-weight: 800;
    line-height: 1.16;
  }
  .sub {
    margin: 22px auto 0;
    max-width: 30em;
    color: var(--muted);
    font-size: clamp(16px, 1.6vw, 19px);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
  }
  /* Apple 공식 배지: 높이 40px 이상, 주변 여백 유지 (Apple 마케팅 가이드라인) */
  .app-store {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .app-store:hover {
    transform: translateY(-2px);
  }
  .app-store img {
    display: block;
    height: 52px;
    width: auto;
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .ghost:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .micro {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 14px;
  }
  .hero-shots {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 22px;
    margin-top: 56px;
  }
  .hero-shots .shot {
    width: 260px;
    height: auto;
    border-radius: 30px;
    border: 1px solid var(--line);
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .hero-shots .front {
    width: 300px;
    z-index: 1;
    animation: pop 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-shots .back:first-child {
    transform: rotate(-4deg) translateY(18px);
    animation: pop 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both;
  }
  .hero-shots .back:last-child {
    transform: rotate(4deg) translateY(18px);
    animation: pop 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s both;
  }
  @keyframes pop {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-shots .shot {
      animation: none;
    }
  }

  /* ───── 카드 그리드 ───── */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 22px;
    margin-top: 110px;
  }
  .card {
    display: flex;
    flex-direction: column;
    grid-column: span 3;
    padding: 40px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .card.wide {
    grid-column: span 6;
    flex-direction: row;
    align-items: center;
    gap: 48px;
    padding-bottom: 0;
  }
  .card.full {
    grid-column: span 6;
  }
  .card.blush {
    background: var(--blush);
  }
  .card.sand {
    background: var(--sand);
  }
  .card.mist {
    background: var(--mist);
  }
  .card.accent {
    background: var(--accent);
    color: #fff;
    border-color: transparent;
  }
  .card-text {
    flex: 1;
    padding-bottom: 40px;
  }
  .card h2 {
    margin: 0;
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 800;
    line-height: 1.28;
  }
  .card p {
    margin: 14px 0 0;
    max-width: 30em;
    color: var(--muted);
  }
  .card.accent p {
    color: rgba(255, 255, 255, 0.86);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    padding: 7px 15px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--line);
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
  }
  /* 화면 캡처는 카드 아래로 살짝 잘려 들어간다 */
  .card-shot {
    margin-top: 28px;
    margin-bottom: -60px;
  }
  .card.wide .card-shot {
    flex: 0 0 260px;
    margin-top: 40px;
  }
  .card-shot.center {
    display: flex;
    justify-content: center;
  }
  .card-shot img {
    display: block;
    width: 100%;
    max-width: 260px;
    height: auto;
    border-radius: 26px 26px 0 0;
    border: 1px solid var(--line);
    border-bottom: none;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .link-chip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 26px 0 0;
    padding: 14px 22px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 17px;
    font-weight: 700;
  }
  .link-chip span {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
  }
  .link-chip em {
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    font-size: 13px;
    font-style: normal;
    font-weight: 600;
  }

  /* ───── 그 밖에 ───── */
  .extras {
    margin-top: 110px;
  }
  .extras-title {
    margin: 0 0 28px;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 800;
  }
  .extras-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 14px 40px;
  }
  .extra {
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .extra h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }
  .extra p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  /* ───── 마무리 ───── */
  .closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-top: 110px;
    padding: 90px 32px;
    border-radius: var(--radius);
    background:
      radial-gradient(60% 80% at 50% 0%, var(--blush) 0%, transparent 70%),
      var(--card);
    border: 1px solid var(--line);
    text-align: center;
  }
  .closing h2 {
    margin: 0;
    max-width: 14em;
    font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 800;
  }
  .closing .micro {
    margin: 0;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    max-width: 1160px;
    margin: 0 auto;
    padding: 40px 24px 56px;
    color: var(--muted);
    font-size: 14px;
